{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-door/operations-snapshot.schema.json",
  "title": "Academic Door Operations Snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "observed_at",
    "scope",
    "costs",
    "quotas",
    "credentials",
    "services",
    "actions",
    "human_actions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observed_at": {
      "type": "string"
    },
    "scope": {
      "const": "ACADEMIC_DOOR_WIDE_TOPOLOGY_DYNAMIC"
    },
    "costs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cost"
      }
    },
    "quotas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quota"
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/credential"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "human_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "evidence": {
      "enum": [
        "ACTUAL",
        "PROVIDER_REPORTED",
        "ESTIMATED",
        "UNKNOWN"
      ]
    },
    "cost": {
      "type": "object",
      "required": [
        "id",
        "service",
        "owner",
        "evidence_class",
        "coverage_status",
        "status",
        "evidence_observed_at",
        "next_evidence_route",
        "human_action_required"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "consumer": {
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence"
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "gross_amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "discount_amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "usage_quantity": {
          "type": [
            "number",
            "null"
          ]
        },
        "usage_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage_status": {
          "enum": [
            "ACTUAL_BILLED",
            "ESTIMATED_USAGE",
            "PROVIDER_REPORTED_FREE",
            "PROVIDER_REPORTED_QUOTA",
            "ACCOUNT_BILLING_UNKNOWN",
            "HUMAN_REPORTED_FREE",
            "CAPABILITY_ONLY_NO_SPEND_EVIDENCE",
            "NOT_EVIDENCED_AS_ACTIVE",
            "HUMAN_REPORTED_NO_PAID_SPEND"
          ]
        },
        "evidence_observed_at": {
          "type": "string"
        },
        "plan_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "included_quota": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorized_paid_budget": {
          "type": [
            "number",
            "null"
          ]
        },
        "authorized_paid_budget_currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_evidence_route": {
          "type": "string",
          "minLength": 1
        },
        "human_action_required": {
          "type": "boolean"
        },
        "human_action_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "quota": {
      "type": "object",
      "required": [
        "id",
        "provider",
        "owner",
        "evidence_class",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence"
        },
        "limit": {
          "type": [
            "number",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "enum": [
            "HEALTHY",
            "WATCH",
            "PRESSURED",
            "EXHAUSTED",
            "UNKNOWN"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "credential": {
      "type": "object",
      "required": [
        "logical_name",
        "provider",
        "owner",
        "consumers",
        "secret_value_policy",
        "status"
      ],
      "properties": {
        "logical_name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secret_value_policy": {
          "const": "NEVER_COLLECT"
        },
        "status": {
          "type": "string"
        },
        "last_legitimate_use_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "storage_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "id",
        "category",
        "owner",
        "evidence_class",
        "status",
        "purpose",
        "consumers",
        "lifecycle_state",
        "current_role",
        "operational_evidence_class",
        "usefulness_status",
        "last_success_at",
        "last_success_source",
        "last_failure_at",
        "last_failure_source",
        "cost_pointer",
        "retirement_condition"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence"
        },
        "status": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycle_state": {
          "enum": [
            "ACTIVE",
            "ACTIVE_DEGRADED",
            "CAPABILITY_ONLY",
            "NOT_EVIDENCED",
            "RETIRED"
          ]
        },
        "current_role": {
          "type": "string",
          "minLength": 1
        },
        "operational_evidence_class": {
          "enum": [
            "OWNER_RUNTIME",
            "PROVIDER_ACCOUNT",
            "HUMAN_REPORTED",
            "CONFIGURATION_ONLY",
            "UNKNOWN"
          ]
        },
        "usefulness_status": {
          "enum": [
            "PROVEN",
            "ACTIVE_UNVERIFIED",
            "QUALIFY_NONE_CURRENT_PATH",
            "CANDIDATE_ONLY",
            "NOT_EVIDENCED",
            "RETIRED"
          ]
        },
        "last_success_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_success_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_failure_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_failure_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_pointer": {
          "type": [
            "string",
            "null"
          ]
        },
        "retirement_condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "repository",
        "workflow_class",
        "evidence_class",
        "status"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "workflow_class": {
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence"
        },
        "status": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "estimated_minutes": {
          "type": [
            "number",
            "null"
          ]
        },
        "window_days": {
          "type": [
            "integer",
            "null"
          ]
        },
        "success_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "failure_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cancelled_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "repository_visibility": {
          "enum": [
            "PUBLIC",
            "PRIVATE",
            "UNKNOWN"
          ]
        },
        "billing_scarcity_class": {
          "enum": [
            "PUBLIC_STANDARD_RUNNER_FREE_ELIGIBLE",
            "PRIVATE_INCLUDED_MINUTES",
            "UNKNOWN"
          ]
        }
      }
    }
  }
}
