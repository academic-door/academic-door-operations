{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academic Door Operations public-safe snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "scope",
    "billing",
    "costs",
    "provider_health",
    "services",
    "actions",
    "alerts",
    "human_actions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "observed_at": { "type": ["string", "null"] },
    "scope": { "const": "ACADEMIC_DOOR_PUBLIC_SAFE" },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_actions"],
      "properties": {
        "github_actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_class", "billable_state"],
          "properties": {
            "evidence_class": { "enum": ["ACTUAL", "UNKNOWN"] },
            "billable_state": { "enum": ["ZERO", "POSITIVE", "UNKNOWN"] }
          }
        }
      }
    },
    "costs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "evidence_class", "amount", "currency", "period", "observed_at"],
        "properties": {
          "service": { "type": "string" },
          "evidence_class": { "const": "ESTIMATED" },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "period": { "const": "CURRENT_MONTH" },
          "observed_at": { "type": ["string", "null"] }
        }
      }
    },
    "provider_health": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "status", "observed_at", "attempts", "available", "failed", "rate_limited", "skipped"],
        "properties": {
          "provider": { "type": "string" },
          "status": { "enum": ["HEALTHY", "WATCH", "PRESSURED", "UNKNOWN"] },
          "observed_at": { "type": ["string", "null"] },
          "attempts": { "type": "integer", "minimum": 0 },
          "available": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "rate_limited": { "type": "integer", "minimum": 0 },
          "skipped": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "lifecycle_state", "usefulness_status", "status", "last_success_at", "last_failure_at"],
        "properties": {
          "id": { "type": "string" },
          "owner": { "type": "string" },
          "lifecycle_state": { "type": "string" },
          "usefulness_status": { "type": "string" },
          "status": { "type": "string" },
          "last_success_at": { "type": ["string", "null"] },
          "last_failure_at": { "type": ["string", "null"] }
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_days", "classes"],
      "properties": {
        "window_days": { "type": "integer", "minimum": 0 },
        "classes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "repositories_observed", "workflows_with_runs", "run_count", "failure_count", "estimated_wall_minutes"],
            "properties": {
              "class": { "enum": ["PUBLIC_STANDARD_RUNNER_FREE_ELIGIBLE", "PRIVATE_INCLUDED_MINUTES"] },
              "repositories_observed": { "type": "integer", "minimum": 0 },
              "workflows_with_runs": { "type": "integer", "minimum": 0 },
              "run_count": { "type": "integer", "minimum": 0 },
              "failure_count": { "type": "integer", "minimum": 0 },
              "estimated_wall_minutes": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "severity", "summary"],
        "properties": {
          "condition": { "type": "string" },
          "severity": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "human_actions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
